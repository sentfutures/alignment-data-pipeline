# Copy this file to .env and fill in your key:
#   cp .env.example .env
# Ask Oliver for an API key (required for backend: api, the default)
ANTHROPIC_API_KEY=
# Optional — only for backend: claude_code (bills your Claude Max subscription).
# Generate with: claude setup-token
# Not needed if you're already logged into Claude Code on this machine.
CLAUDE_CODE_OAUTH_TOKEN=

# Optional: only evals/diversity.py (embedding-based diversity audit) reads this
OPENAI_API_KEY=

# Optional: only evals/publish_hf.py (Hugging Face dataset publishing) reads this.
# Needs write access to the target repo/org. Not needed if you've already run
# `huggingface-cli login` on this machine — huggingface_hub checks this env var
# first, then falls back to that cached login.
HF_TOKEN=

